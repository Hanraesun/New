{
  "id": "/maptest/",
  "name": "Website Map Navigation",
  "short_name": "MapNav",
  "description": "Liquid Glass navigation with 3D maps, speed limits and turn-by-turn routing.",
  "start_url": "https://hanraesun.github.io/maptest/",
  "scope": "./",
  "display": "standalone",
